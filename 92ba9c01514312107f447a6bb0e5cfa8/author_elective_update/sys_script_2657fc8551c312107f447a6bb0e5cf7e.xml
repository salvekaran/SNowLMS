        <script><![CDATA[function executeRule(current, previous /*null when async*/) {

	// Add your code here
var gr= new GlideRecord('x_snc_leave_mana_0_leave_calculator');
gr.addQuery('country.name',current.location.country);
gr.query();
if (gr.next)
{
 if (gr.leave_assignment =='yearly')
{
		var gdt= new GlideDateTime();
		var currentMonth = gdt.getMonthLocalTime();
		var daysLeft = 12 - currentMonth;
		var perMonth = gr.leaves/12;
		var totalLeaves = perMonth * monthsLeft;

		var leavebucket= newGliedRecord('x_snc_leave_mana_0_leave_bucket');
		leavebucket.intialize();
		leavebucket.type=gr.type;
		leavebucket. accrued = totalLeaves;
		leavebucket. balance = totalLeaves;
		leavebucket. taken = 0;
		leavebucket.employee =current.sys_id;
		leavebucket.insert();
}

	else if (gr.leave_assignment =='monthly')
	{
		var perMonthM= gr.leaves /12;
		
		var leavebucketm= newGliedRecord('x_snc_leave_mana_0_leave_bucket');
		leavebucketm.intialize();
		leavebucketm.type=gr.type;
		leavebucketm. accrued = perMonthM;
		leavebucketm. balance = perMonthM;
		leavebucketm. taken = 0;
		leavebucketm.employee =current.sys_id;
		leavebucketm.insert();
}
	}

}

(current, previous);]]></script>
